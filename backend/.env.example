# ContractIQ Environment Configuration

# Database Configuration (PostgreSQL or SQLite fallback)
# PostgreSQL example: postgresql://postgres:postgres@localhost:5432/contractiq
DATABASE_URL=sqlite:///./contractiq.db

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_contractiq_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# AI_PROVIDER can be 'mock', 'openai', 'anthropic', 'gemini'
AI_PROVIDER=mock
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o

# Storage Provider Configuration
# STORAGE_PROVIDER can be 'local', 's3'
STORAGE_PROVIDER=local
STORAGE_DIR=./uploaded_contracts
STORAGE_BUCKET=contractiq-storage
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Application Settings
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
PORT=8000
